properties([
    disableConcurrentBuilds(),
    parameters([
        string(name: 'SOURCE_URL', defaultValue: 'https://github.com/ssvkotamraju/E-ticketing.git', description: 'Use your fork for push-trigger tests'),
        string(name: 'SOURCE_BRANCH', defaultValue: 'main', description: 'Git branch only, without refs/heads/'),
        string(name: 'LAB_BRANCH', defaultValue: 'main', description: 'Araiza execution branch containing the lab tests'),
        booleanParam(name: 'FAIL_TEST', defaultValue: false, description: 'Trigger the controlled lab JUnit failure')
    ])
])

node {
    def repo = params.SOURCE_URL
    def branch = params.SOURCE_BRANCH
    def sourceDir = 'source'
    if (!(sourceDir ==~ /[A-Za-z0-9][A-Za-z0-9_-]*/)) {
        error('Choose a single relative checkout folder name.')
    }
    echo "Build #${env.BUILD_NUMBER}"
    stage('Clean workspace') {
        deleteDir()
    }
    stage('Checkout application') {
        dir(sourceDir) {
            git branch: branch, url: repo
        }
    }

    stage('Checkout lab tests') {
        dir('lab') {
            checkout changelog: false, poll: false, scm: scmGit(
                branches: [[name: "*/${params.LAB_BRANCH}"]],
                userRemoteConfigs: [[url: 'https://github.com/DevXOmar/Araiza.git']]
            )
        }
    }

    def mavenHome = tool name: 'Maven3', type: 'maven'
    def javaHome = tool name: 'JDK21', type: 'jdk'
    withEnv(["JAVA_HOME=${javaHome}", "PATH+JAVA=${javaHome}/bin", "PATH+MAVEN=${mavenHome}/bin"]) {
        def mvn = { goals ->
            if (isUnix()) {
                sh "mvn -B -ntp ${goals}"
            } else {
                bat "mvn -B -ntp ${goals}"
            }
        }

        stage('Lab JUnit tests') {
            String failure = params.FAIL_TEST ? '-Dlab.forceFailure=true' : ''
            try {
                dir('lab/s1/ci-tests') {
                    mvn("clean test ${failure}")
                }
            } finally {
                junit allowEmptyResults: true, testResults: 'lab/s1/ci-tests/target/surefire-reports/TEST-*.xml'
            }
        }

        stage('Maven build, test and package') {
            dir(sourceDir) {
                mvn('clean test package')
            }
        }

    }
    stage('Archive WAR') {
        archiveArtifacts artifacts: "${sourceDir}/target/LibraryRegistration.war", fingerprint: true
    }
}
