// The Generic Webhook Trigger job filters the GitHub event before scheduling this pipeline.
node('pr-isolated') {
    def pr = env.PR_NUMBER
    if (!(pr ==~ /[1-9][0-9]*/) || env.PR_BASE != 'main') {
        error('This job accepts only a filtered pull_request event targeting main.')
    }
    // Set this constant to your own HMS fork when creating the job.
    def repository = 'https://github.com/ssvkotamraju/HMS.git'
    deleteDir()
    stage('Checkout PR merge ref') {
        checkout changelog: false, poll: false, scm: scmGit(
            branches: [[name: "refs/remotes/origin/pr/${pr}/merge"]],
            userRemoteConfigs: [[
                url: repository,
                refspec: "+refs/pull/${pr}/merge:refs/remotes/origin/pr/${pr}/merge"
            ]],
            extensions: [cloneOption(honorRefspec: true, noTags: true)]
        )
    }
    stage('Test and package') {
        def mav = tool name: 'Maven3', type: 'maven'
        def jdk = tool name: 'JDK21', type: 'jdk'
        withEnv(["JAVA_HOME=${jdk}", "PATH+JAVA=${jdk}/bin", "PATH+MAVEN=${mav}/bin"]) {
            if (isUnix()) {
                sh 'mvn -B -ntp clean test package'
            } else {
                bat 'mvn -B -ntp clean test package'
            }
        }
    }
    stage('Archive') {
        archiveArtifacts artifacts: 'target/LibraryRegistration.war', fingerprint: true
    }
}
